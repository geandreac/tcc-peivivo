{
  "name": "pei-vivo",
  "private": true,
  "version": "0.1.0",
  "description": "PEI Vivo — adaptação personalizada e colaborativa de materiais didáticos (TCC SI, CEUNI FAMETRO)",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "npm run dev -w apps/web",
    "build": "npm run build -w apps/web",
    "preview": "npm run preview -w apps/web",
    "test": "npm test --workspaces --if-present",
    "test:motor": "npm test -w packages/motor-adaptacao",
    "test:web": "npm test -w apps/web",
    "test:coverage": "npm run test:coverage --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "contraste": "node scripts/contraste.mjs",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:push": "supabase db push",
    "db:validar": "node scripts/validar-migrations.mjs",
    "test:e2e": "npm run test:e2e -w apps/web",
    "diagramas": "node scripts/diagramas/gerar.mjs",
    "artigo:telas": "node scripts/artigo/capturar-telas.mjs",
    "artigo": "python scripts/artigo/gerar_docx.py",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:backup": "node scripts/backup-dados.mjs"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@eslint/js": "^9.39.5",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "supabase": "^2.0.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  }
}
