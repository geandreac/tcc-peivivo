# PEI Vivo — variáveis de ambiente (modelo). Copie para `.env` e preencha.
# `.env` está no .gitignore e NUNCA deve ser commitado. Nenhum valor real aqui.
#
# Sem `VITE_API=supabase`, o app roda na DEMONSTRAÇÃO (mockApi, dados fictícios).
# Com `VITE_API=supabase` + URL + chave anon, roda o sistema real (R2).
# Para desenvolvimento, use `apps/web/.env.local` (também ignorado pelo git).

# --- apps/web (expostas ao navegador; só a chave ANON, nunca a service_role) ---
VITE_API=supabase
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=cole-aqui-a-anon-key-publica
# "true" liga a camada de IA na interface (RF10, Fase 5). Padrão: desligada (RN06).
VITE_IA_ATIVA=false

# --- Edge Functions (secrets do servidor; configurar com `supabase secrets set`) ---
# SUPABASE_SERVICE_ROLE_KEY=  # nunca no cliente, nunca no repositório
# PROVEDOR_IA_API_KEY=        # só na Fase 5

# --- CI (GitHub → Settings → Secrets and variables) ---
# secrets.SUPABASE_URL, secrets.SUPABASE_ANON_KEY  → workflow manter-supabase-ativo.yml
# vars.SUPABASE_PING_ATIVO=true                    → liga o ping semanal
